[
  {
    "type": "function",
    "name": "createGeniusToken",
    "inputs": [
      { "name": "tokenName", "type": "string" },
      { "name": "tokenTicker", "type": "string" },
      { "name": "ipfsMetadata", "type": "string" },
      { "name": "referralCode", "type": "bytes32" }
    ],
    "outputs": [{ "name": "tokenAddress", "type": "address" }],
    "stateMutability": "payable"
  },
  {
    "type": "event",
    "name": "TokenCreated",
    "inputs": [
      { "name": "tokenAddress", "type": "address", "indexed": true },
      { "name": "deployer", "type": "address", "indexed": true },
      { "name": "tokenName", "type": "string", "indexed": false },
      { "name": "tokenTicker", "type": "string", "indexed": false },
      { "name": "ipfsMetadata", "type": "string", "indexed": false }
    ],
    "anonymous": false
  }
]
